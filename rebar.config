%%-*- mode: erlang -*-
{erl_opts, [warnings_as_errors]}.
{cover_enabled, true}.
{edoc_opts, [{preprocess, true}]}.

{xref_checks, [undefined_function_calls]}.

{deps, [{mochiweb, {git, "https://github.com/OpenRiak/mochiweb.git", {branch, "openriak-3.4"}}}]}.

{eunit_opts, [
              no_tty,
              {report, {eunit_progress, [colored, profile]}}
             ]}.

{profiles,
 [{test,
   [{deps, [
    {meck, {git, "https://github.com/OpenRiak/meck.git", {branch, "openriak-3.4"}}},
    {ibrowse, {git, "https://github.com/OpenRiak/ibrowse.git", {branch, "openriak-3.4"}}}
           ]},
    {erl_opts, [debug_info]}
   ]}
 ]}.
